.tabs {
  display: flex;
  background: #fff;
}
.tab {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  color: #666;
  font-size: 28rpx;
}
.tab.active {
  color: #FF6B35;
  font-weight: bold;
  border-bottom: 4rpx solid #FF6B35;
}
.order-no {
  color: #999;
  font-size: 24rpx;
}
.status {
  color: #FF6B35;
  font-size: 26rpx;
}
.brief {
  margin: 16rpx 0;
  font-size: 28rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.muted {
  color: #999;
  font-size: 24rpx;
}
.loading {
  text-align: center;
  padding: 20rpx 0;
}
