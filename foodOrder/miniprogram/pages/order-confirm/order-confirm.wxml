<view class="page">
  <view class="card">
    <view class="field">
      <text class="label">桌号</text>
      <input class="input" value="{{tableNo}}" placeholder="请输入桌号" bindinput="onTableNoInput" />
    </view>
    <view class="field">
      <text class="label">备注</text>
      <input class="input" value="{{remark}}" placeholder="口味偏好等(选填)" bindinput="onRemarkInput" />
    </view>
  </view>

  <view class="card">
    <view class="item" wx:for="{{items}}" wx:key="productId">
      <text>{{item.name}}</text>
      <text class="muted">x{{item.count}}</text>
      <text>¥{{item.priceText}}</text>
    </view>
  </view>

  <view class="footer">
    <view>
      <text class="label">合计</text>
      <text class="price total">¥{{totalText}}</text>
    </view>
    <view class="btn-primary go-btn {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">提交订单</view>
  </view>
</view>
