.page {
  padding-bottom: 160rpx;
}
.toolbar {
  display: flex;
  justify-content: flex-end;
  padding: 16rpx 30rpx;
}
.clear {
  color: #999;
  font-size: 26rpx;
}
.item {
  display: flex;
  align-items: center;
}
.img {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}
.info {
  flex: 1;
  margin-left: 20rpx;
}
.name {
  font-size: 28rpx;
  margin-bottom: 20rpx;
}
.del {
  color: #ccc;
  padding: 20rpx;
  font-size: 32rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.total {
  font-size: 34rpx;
}
.go-btn {
  width: 300rpx;
}
