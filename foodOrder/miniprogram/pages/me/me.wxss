.profile {
  display: flex;
  align-items: center;
  padding: 60rpx 40rpx;
  background: linear-gradient(180deg, #FF6B35, #ff8c5a);
}
.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 60rpx;
}
.info {
  margin-left: 30rpx;
  color: #fff;
}
.role {
  font-size: 36rpx;
  font-weight: bold;
}
.openid {
  font-size: 24rpx;
  opacity: 0.9;
  margin-top: 8rpx;
}
.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.menu-item:last-child {
  border-bottom: none;
}
.arrow {
  color: #ccc;
  font-size: 36rpx;
}
.tips-title {
  font-weight: bold;
  margin-bottom: 16rpx;
}
.tip {
  color: #666;
  font-size: 24rpx;
  padding: 6rpx 0;
}
