.grid {
  display: flex;
  flex-wrap: wrap;
  padding: 40rpx 20rpx;
}
.entry {
  width: 50%;
  box-sizing: border-box;
  padding: 20rpx;
  text-align: center;
}
.icon {
  background: #fff;
  border-radius: 24rpx;
  padding: 50rpx 0;
  font-size: 72rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.label {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #333;
}
