.tabs {
  display: flex;
  background: #fff;
  white-space: nowrap;
}
.tab {
  display: inline-block;
  padding: 24rpx 32rpx;
  color: #666;
  font-size: 28rpx;
}
.tab.active {
  color: #FF6B35;
  font-weight: bold;
  border-bottom: 4rpx solid #FF6B35;
}
.table {
  font-weight: bold;
  font-size: 30rpx;
}
.brief {
  margin: 16rpx 0;
  font-size: 28rpx;
}
.remark {
  color: #FF9500;
  font-size: 24rpx;
  margin-bottom: 8rpx;
}
.actions {
  display: flex;
  gap: 16rpx;
}
.btn {
  border-radius: 12rpx;
  text-align: center;
}
.btn.small {
  padding: 12rpx 32rpx;
  font-size: 26rpx;
}
.btn.primary {
  background: #FF6B35;
  color: #fff;
}
.btn.danger {
  border: 2rpx solid #FF3B30;
  color: #FF3B30;
}
.btn.disabled {
  opacity: 0.5;
}
.muted {
  color: #999;
  font-size: 24rpx;
}
.loading {
  text-align: center;
  padding: 20rpx 0;
}
