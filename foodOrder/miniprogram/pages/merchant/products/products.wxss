.list {
  padding-bottom: 160rpx;
}
.group-name {
  font-weight: bold;
  font-size: 30rpx;
  margin-bottom: 16rpx;
  color: #FF6B35;
}
.product {
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.product:last-child {
  border-bottom: none;
}
.pname {
  font-size: 28rpx;
}
.status {
  font-size: 24rpx;
  color: #34C759;
}
.status.off {
  color: #999;
}
.del {
  color: #FF3B30;
  font-size: 24rpx;
}
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 110rpx;
  height: 110rpx;
  border-radius: 50%;
  background: #FF6B35;
  color: #fff;
  font-size: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(255, 107, 53, 0.4);
}
