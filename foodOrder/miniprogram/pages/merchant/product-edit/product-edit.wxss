.field {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.field:last-child {
  border-bottom: none;
}
.label {
  width: 180rpx;
  color: #666;
}
.input {
  flex: 1;
}
.picker {
  color: #333;
}
.image-box {
  display: flex;
}
.img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
}
.img-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #bbb;
  font-size: 24rpx;
}
.save {
  margin: 40rpx 20rpx;
}
