.page {
  padding-bottom: 160rpx;
}
.header {
  display: flex;
  align-items: center;
}
.table-no {
  margin-left: 24rpx;
  font-weight: bold;
}
.order-no {
  margin-left: auto;
  color: #999;
  font-size: 24rpx;
}
.item {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f5f5f5;
}
.muted {
  color: #999;
}
.total-row {
  padding-top: 20rpx;
  font-size: 30rpx;
}
.remark {
  margin-top: 16rpx;
  color: #666;
  font-size: 24rpx;
}
.tl-item {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}
.dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF6B35;
  margin-right: 16rpx;
}
.tl-label {
  color: #333;
}
.tl-time {
  margin-left: auto;
  color: #999;
  font-size: 24rpx;
}
.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 12rpx rgba(0, 0, 0, 0.05);
}
.action-btn {
  padding: 14rpx 40rpx;
}
