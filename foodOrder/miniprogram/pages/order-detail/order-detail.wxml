<view wx:if="{{order}}" class="page">
  <view class="card header">
    <status-tag status="{{order.status}}" />
    <view class="table-no">桌号:{{order.tableNo}}</view>
    <view class="order-no">单号:{{order.orderNo}}</view>
  </view>

  <view class="card">
    <view class="item" wx:for="{{items}}" wx:key="productId">
      <text>{{item.name}}</text>
      <text class="muted">x{{item.count}}</text>
      <text>¥{{item.priceText}}</text>
    </view>
    <view class="row-between total-row">
      <text>合计</text>
      <text class="price">¥{{totalText}}</text>
    </view>
    <view wx:if="{{order.remark}}" class="remark">备注:{{order.remark}}</view>
  </view>

  <view class="card" wx:if="{{timeline.length}}">
    <view class="tl-item" wx:for="{{timeline}}" wx:key="label">
      <view class="dot"></view>
      <view class="tl-label">{{item.label}}</view>
      <view class="tl-time">{{item.timeText}}</view>
    </view>
  </view>

  <view class="footer" wx:if="{{actions.length}}">
    <view
      wx:for="{{actions}}"
      wx:key="action"
      class="btn-plain action-btn {{actionLoading === item.action ? 'disabled' : ''}}"
      data-action="{{item.action}}"
      bindtap="onAction"
    >{{item.label}}</view>
  </view>
</view>
<view wx:else class="empty">加载中...</view>
