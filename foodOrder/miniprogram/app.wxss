/* 全局样式 */
page {
  background: #F6F6F6;
  font-size: 28rpx;
  color: #333;
}

/* 主按钮 */
.btn-primary {
  background: #FF6B35;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  padding: 20rpx 0;
  text-align: center;
}
.btn-primary.disabled {
  opacity: 0.5;
}
.btn-plain {
  background: #fff;
  color: #FF6B35;
  border: 2rpx solid #FF6B35;
  border-radius: 12rpx;
  font-size: 28rpx;
  padding: 14rpx 0;
  text-align: center;
}

/* 卡片与价格 */
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx;
}
.price {
  color: #FF6B35;
  font-weight: bold;
}

/* 空态 */
.empty {
  text-align: center;
  color: #999;
  padding: 100rpx 0;
  font-size: 26rpx;
}

/* 通用行 */
.row {
  display: flex;
  align-items: center;
}
.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
